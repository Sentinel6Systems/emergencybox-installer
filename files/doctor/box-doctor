#!/usr/bin/env python3
"""box-doctor: the EmergencyBox self-check. Runs at boot and every 15 minutes (box-doctor.timer).

Each part of the box lists what to check in /etc/emergencybox/doctor.d/*.check, one per line:
    service UNIT NAME...           the unit is active
    http PATH UNIT NAME...         http://127.0.0.1PATH (Host: the box) answers 2xx/3xx; UNIT = what to restart, or -
    hotspot NAME...                the Wi-Fi hotspot is up (box-hotspot-check)
Something that's down is restarted once, then checked again. Free space under the reserve
(SPACE_RESERVE_GB) + 5 GB is reported. Content files the services can't read (copied in from a
private backup, mode 600) are made readable.
The result goes to /run/emergencybox/doctor.json (shown by the landing page via boxd).
"""
import glob, json, os, shutil, subprocess, sys, time, urllib.request

OUT = "/run/emergencybox/doctor.json"
ENV = {"ADDRESS": "box.lan", "CONTENT_DIR": "/srv/box/content", "SPACE_RESERVE_GB": "5"}
try:
    for line in open("/etc/emergencybox/box.env"):
        k, _, v = line.strip().partition("=")
        if k:
            ENV[k] = v
except OSError:
    pass
ADDRESS = ENV["ADDRESS"]
CONTENT = ENV["CONTENT_DIR"]
RESERVE = int(ENV["SPACE_RESERVE_GB"]) if ENV["SPACE_RESERVE_GB"].isdigit() else 5


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).returncode == 0


def active(unit):
    return sh("systemctl", "is-active", "--quiet", unit)


def restart(unit):
    if unit and unit != "-":
        sh("systemctl", "restart", unit)
        time.sleep(3)


def http_ok(path):
    try:
        req = urllib.request.Request("http://127.0.0.1" + path, headers={"Host": ADDRESS})
        opener = urllib.request.build_opener(NoRedirect)
        with opener.open(req, timeout=10) as r:
            return 200 <= r.status < 400
    except urllib.error.HTTPError as e:
        return 300 <= e.code < 400
    except Exception:
        return False


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


def fix_content_modes():
    """Content copied in keeps its modes (rsync -a from a private backup: 600/700). Make every
    file readable and every folder enterable, so the services can serve it. Never removes rights."""
    fixed = 0
    for root, dirs, files in os.walk(CONTENT):
        for n in dirs + files:
            p = os.path.join(root, n)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if os.path.islink(p):
                continue
            want = st.st_mode | (0o555 if os.path.isdir(p) else 0o444)
            if want != st.st_mode:
                try:
                    os.chmod(p, want & 0o7777); fixed += 1
                except OSError:
                    pass
    return fixed


def run():
    checks = []
    for f in sorted(glob.glob("/etc/emergencybox/doctor.d/*.check")):
        for line in open(f):
            w = line.split()
            if not w or w[0].startswith("#"):
                continue
            kind = w[0]
            c = {"name": "", "ok": False, "fixed": False, "detail": ""}
            if kind == "service" and len(w) >= 2:
                unit, c["name"] = w[1], " ".join(w[2:]) or w[1]
                c["ok"] = active(unit)
                if not c["ok"]:
                    restart(unit); c["ok"] = c["fixed"] = active(unit)
                c["detail"] = unit
            elif kind == "http" and len(w) >= 3:
                path, unit, c["name"] = w[1], w[2], " ".join(w[3:]) or w[1]
                c["ok"] = http_ok(path)
                if not c["ok"] and unit != "-":
                    restart(unit); c["ok"] = c["fixed"] = http_ok(path)
                c["detail"] = path
            elif kind == "hotspot":
                c["name"] = " ".join(w[1:]) or "Wi-Fi hotspot"
                c["ok"] = sh("/usr/local/sbin/box-hotspot-check")
                c["detail"] = "emergencybox-hotspot"
            else:
                continue
            checks.append(c)
    u = shutil.disk_usage("/")
    gb = u.free / 1e9
    checks.append({"name": "Free space", "ok": gb >= RESERVE + 5, "fixed": False,
                   "detail": "%.0f GB free (uploads stop at %d GB)" % (gb, RESERVE)})
    n = fix_content_modes()
    if n:
        checks.append({"name": "Content readable", "ok": True, "fixed": True,
                       "detail": "made %d copied-in files readable" % n})
    res = {"ok": all(c["ok"] for c in checks), "time": int(time.time()), "checks": checks}
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(res, f)
    os.replace(tmp, OUT)
    return res


if __name__ == "__main__":
    r = run()
    for c in r["checks"]:
        mark = "OK  " if c["ok"] else "FAIL"
        extra = " (restarted)" if c["fixed"] else ""
        if "-q" not in sys.argv or not c["ok"] or c["fixed"]:
            print("%s  %-34s %s%s" % (mark, c["name"], c["detail"], extra))
    sys.exit(0 if r["ok"] else 1)
