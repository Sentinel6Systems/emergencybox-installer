[Unit]
Description=EmergencyBox landing-page helper (stats, restart, turn off)
After=network.target

[Service]
# Runs as root so it can read Wi-Fi station counts and call poweroff/reboot.
# It only listens on 127.0.0.1; nginx exposes /api/ to the hotspot.
ExecStart=/usr/bin/python3 /opt/boxd/boxd.py
Environment=BOXD_PORT=8181
Environment=BOXD_HOTSPOT_IF={{HOTSPOT_IF}}
# Colon-separated mount points shown as storage
Environment=BOXD_DISKS=/
Environment=BOXD_CONTENT={{CONTENT_DIR}}
Environment=BOXD_MAPS={{FIELDMAP_DIR}}/data
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=64M

[Install]
WantedBy=multi-user.target
